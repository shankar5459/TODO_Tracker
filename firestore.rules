rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Piggy Pal (kids-pocket-bank) — keep intact ----
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['familyId', 'createdAt'])
        && request.resource.data.familyId is string;
      allow update, delete: if false;
    }

    match /families/{familyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1
        && request.resource.data.inviteCode is string
        && request.resource.data.name is string;

      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
        )
      );

      allow delete: if false;

      match /kids/{kidId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }

      match /transactions/{txnId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
      }
    }

    // ---- Todo Tracker — per-user data ----
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
